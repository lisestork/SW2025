@prefix : <http://example/base#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix ns: <http://example/other#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


ns:Food rdf:type owl:Class . 
ns:MealType rdf:type owl:Class .
ns:Ingredient rdf:type owl:Class .
ns:Dish rdf:type owl:Class ;
    rdfs:subClassOf ns:Food . 
ns:Country rdf:type owl:Class . 
ns:VeganDish rdf:type owl:Class ;
    rdfs:subClassOf ns:Dish . 
ns:VegetarianDish rdf:type owl:Class ;
    rdfs:subClassOf ns:Dish . 
ns:MeatDish rdf:type owl:Class ; 
    rdfs:subClassOf ns:Dish . 
ns:Chef rdf:type owl:Class .

ns:preparedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ns:Dish ;
    rdfs:range ns:Chef .
ns:eatenAt rdf:type owl:ObjectProperty ;
    rdfs:domain ns:Dish ;
    rdfs:range ns:MealType .
ns:contains rdf:type owl:ObjectProperty ;
    rdfs:domain ns:Dish ;
    rdfs:range ns:Ingredient .
ns:origins rdf:type owl:ObjectProperty ;
    rdfs:domain ns:Dish ;
    rdfs:range ns:Country .
    
ns:isVegan rdf:type owl:DatatypeProperty ;
    rdfs:domain ns:Dish ;
    rdfs:range xsd:boolean .
ns:hasCookingTime rdf:type owl:DatatypeProperty ;
    rdfs:domain ns:Ingredient ;
    rdfs:range xsd:integer .
ns:hasGramsOfProtein rdf:type owl:DatatypeProperty ;
    rdfs:domain ns:Ingredient ;
    rdfs:range xsd:float .

# Disjoint classes
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns:VegetarianDish
                ns:MeatDish
              )
] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns:VeganDish
                ns:MeatDish
              )
] .

#Alternatively, disjoint classes can be defined similar to this:
ns:VegetarianDish owl:disjointWith ns:MeatDish .
ns:VeganDish owl:disjointWith ns:MeatDish .

# Functional Property characteristics
ns:isVegan rdf:type owl:FunctionalProperty .
ns:hasGramsOfProtein rdf:type owl:FunctionalProperty .
ns:hasCookingTime rdf:type owl:FunctionalProperty .

# Cardinality restrictions
ns:Dish rdfs:subClassOf [ 
    rdf:type owl:Restriction ;
    owl:onProperty ns:contains ;
    owl:minCardinality 2
] .

# Class relationship restrictions
ns:VeganDish owl:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ns:isVegan ;
    owl:hasValue "true"^^xsd:boolean  
] .

ns:Dish owl:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ns:contains ;
    owl:allValuesFrom ns:Ingredient    
] .

ns:MealType a owl:Class ;
        owl:equivalentClass  [ a owl:Class ;
        owl:oneOf  (         
            :breakfast
            :Lunch
            :dinner)
] .

:breakfast a ns:MealType, owl:NamedIndividual .
:lunch a ns:MealType, owl:NamedIndividual .
:dinner a ns:MealType, owl:NamedIndividual .

:stirFryRamen rdf:type ns:Dish, ns:VeganDish, ns:Food ;
    ns:contains :peanutButter ;
    ns:contains :ramenNoodle ;
    ns:contains :soy ; 
    ns:eatenAt :dinner ;
    ns:isVegan "true"^^xsd:boolean ; 
    ns:hasCookingTime "90"^^xsd:integer ;
    ns:preparedBy :jamie_oliver ;
    ns:origins :japan . 

#Ingredients 
:peanutButter rdf:type ns:Ingredient, owl:NamedIndividual ;
    ns:hasGramsOfProtein "9.5"^^xsd:float .

:ramenNoodle rdf:type ns:Ingredient, owl:NamedIndividual ; 
    ns:hasGramsOfProtein "20.3"^^xsd:float . 

:soy rdf:type ns:Ingredient, owl:NamedIndividual ; 
    ns:hasGramsOfProtein "30"^^xsd:float . 
    
#Other 
:jamie_oliver rdf:type ns:Chef, owl:NamedIndividual . 
:japan rdf:type ns:Country, owl:NamedIndividual . 
:dinner rdf:type ns:MealType, owl:NamedIndividual .
